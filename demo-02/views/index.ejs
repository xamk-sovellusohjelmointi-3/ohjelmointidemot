<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <style>

        .display-1 {
            font-size: 24pt;
        }

        .display-2 {
            font-size: 20pt;
        }

    </style>
    <title>Demo 2</title>
</head>
<body>
    <div class="container">
        <h1 class="display-1">Demo 2: Lomakkeiden käsittely EJS 🔄 Express</h1>

        <h2 class="display-2">Ostoslista</h2>

        <ul class="mb-3 list-group list-group-flush">
            <% ostokset.forEach((ostos) => { %>

                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>
                        <a href="/poimittu/?id=<%=ostos.id%>&poimittu=<%=ostos.poimittu%>" style="text-decoration: none; color: black;">
                        <% if (ostos.poimittu) { %>
                            <i class="bi bi-check-square"></i>
                        <% } else { %>
                            <i class="bi bi-square"></i>
                        <% } %>
                        </a>
                        <%= ostos.tuote %>
                    </span>
                    <form method="POST" action="/poista">
                        <input type="hidden" name="id" value="<%= ostos.id %>">

                        <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
                    </form>
                    
                </li>
            <% }); %>
        </ul>

        <form method="POST" action="/">

            <input type="text" name="tuote" class="mb-3 form-control" placeholder="Kirjoita tuote...">

            <button type="submit" class="input-group btn btn-primary btn-sm">Lisää tuote ostoslistaan</button>

        </form>

    </div>
</body>
</html>